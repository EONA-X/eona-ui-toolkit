{
  "name": "eona-ui-toolkit-docs-svelte",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node -e \"require('fs').cpSync('node_modules/@eona-x/ui-toolkit-css/logo','public/logo',{recursive:true})\"",
    "build": "svelte-check --fail-on-warnings && vite build",
    "dev": "npm run prebuild && vite"
  },
  "dependencies": {
    "@eona-x/ui-toolkit-css": "file:../../packages/css",
    "@eona-x/ui-toolkit-svelte": "file:../../packages/svelte"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte": "^5.38.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.0"
  }
}
