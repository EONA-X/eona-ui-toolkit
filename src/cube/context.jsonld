{
  "@context": {
    "qb": "http://purl.org/linked-data/cube#",
    "chart": "https://eona-x.eu/shape/chart-profile#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "type": "@type",
    "DataSet": "qb:DataSet",
    "Observation": "qb:Observation",
    "dataSet": { "@id": "qb:dataSet", "@type": "@id" },
    "observations": { "@reverse": "qb:dataSet" },
    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "category": "chart:category",
    "series": "chart:series",
    "date": "chart:date",
    "value": "chart:value",
    "unit": "chart:unit",
    "order": { "@id": "chart:order", "@type": "xsd:integer" }
  }
}
