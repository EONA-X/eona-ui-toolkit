/target
Cargo.lock

# npm build output of the generated React package. `packages/react/src`,
# `package.json`, `tsconfig.json` and `README.md` ARE committed — they are the
# generator's deliverable and `cargo xtask check` diffs them — but `dist/` is
# tsup's output and `node_modules/` is npm's, and neither is written by any
# stage of the generator. Keeping them untracked is also what lets the drift
# gate treat every other file under packages/react as one it owns.
/packages/*/dist/
/packages/*/node_modules/
/packages/*/package-lock.json
/packages/*/.svelte-kit/

# The bridge parity suite's npm install and its compiled components.
/tests/bridge-parity/node_modules/
/tests/bridge-parity/.out/

# Rendered by `cargo run --example render-docs`; the Pages workflow builds it.
/dist/

# The svelte-wasm example's build output (`wasm-pack build --target web examples/svelte-wasm`).
/examples/svelte-wasm/target/
/examples/svelte-wasm/pkg/
