{
  "name": "@eona-x/ui-toolkit-menu",
  "version": "0.10.1",
  "description": "Fixed top menu for EONA-X sites: vanilla JS, configured from Turtle at build time or JSON-LD at runtime.",
  "license": "Apache-2.0",
  "repository": {"type":"git","url":"git+https://github.com/EONA-X/eona-ui-toolkit.git","directory":"packages/menu"},
  "type": "module",
  "sideEffects": ["./dist/*.js","*.css"],
  "exports": {
    ".": "./src/index.js",
    "./ttl": "./lib/ttl.js",
    "./turtle": "./lib/turtle.js",
    "./menu.css": "./menu.css",
    "./dist/menu.js": "./dist/menu.js",
    "./context.jsonld": "./vocab/context.jsonld",
    "./package.json": "./package.json"
  },
  "bin": {"eona-menu-ttl": "./scripts/ttl-to-json.mjs", "eona-menu-build": "./scripts/build.mjs"},
  "files": ["src","lib","scripts","vocab","dist","menu.css","README.md"],
  "scripts": {"build": "node scripts/build.mjs", "test": "node scripts/build.mjs && node --test test/*.test.js"},
  "dependencies": {"@eona-x/ui-toolkit-css": "0.10.1"},
  "devDependencies": {"jsdom": "^25.0.0"},
  "engines": {"node": ">=20"},
  "publishConfig": {"access":"public","provenance":true}
}
