{
  "@context": {
    "qb": "http://purl.org/linked-data/cube#",
    "chart": "https://eona-x.eu/shape/chart-profile#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "urn:example:ds",
      "@type": "qb:DataSet",
      "rdfs:label": "Sample",
      "chart:unit": "kWh",
      "rdfs:comment": [
        "Energy per site",
        "Second note"
      ]
    },
    {
      "@id": "urn:example:o1",
      "@type": "qb:Observation",
      "qb:dataSet": {
        "@id": "urn:example:ds"
      },
      "chart:category": "A",
      "chart:value": 3.5
    },
    {
      "@id": "urn:example:o2",
      "@type": "qb:Observation",
      "qb:dataSet": {
        "@id": "urn:example:ds"
      },
      "chart:category": "B",
      "chart:value": {
        "@value": "2.25",
        "@type": "xsd:decimal"
      }
    }
  ]
}
